{
	"name": "@placeholderco/placeholder-ui",
	"version": "2.5.4",
	"description": "A modern, customizable Svelte 5 UI component library with comprehensive theming support. Re-brand it with a single config object.",
	"license": "MIT",
	"author": "Placeholderco",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PlaceholderUI/placeholder-ui.git"
	},
	"homepage": "https://github.com/PlaceholderUI/placeholder-ui#readme",
	"bugs": {
		"url": "https://github.com/PlaceholderUI/placeholder-ui/issues"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"ui",
		"components",
		"design-system",
		"css-variables",
		"theming",
		"dark-mode",
		"tiptap",
		"codemirror"
	],
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"clean": "rimraf dist build .svelte-kit",
		"publish:package": "pnpm publish --access public"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css",
		"**/util/dayjs.js"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./app.css": "./dist/app.css",
		"./styles.css": "./dist/styles.css"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.26.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.4.1",
		"globals": "^17.12.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.24",
		"rimraf": "^6.1.3",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.0",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.12",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/lang-sql": "^6.10.0",
		"@codemirror/language": "^6.12.4",
		"@codemirror/legacy-modes": "^6.5.4",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.4",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.11",
		"@lezer/highlight": "^1.2.3",
		"@tiptap/core": "^3.31.3",
		"@tiptap/extension-bubble-menu": "^3.31.3",
		"@tiptap/extension-code-block": "^3.31.3",
		"@tiptap/extension-collaboration": "^3.31.3",
		"@tiptap/extension-collaboration-caret": "^3.31.3",
		"@tiptap/extension-color": "^3.31.3",
		"@tiptap/extension-image": "^3.31.3",
		"@tiptap/extension-link": "^3.31.3",
		"@tiptap/extension-placeholder": "^3.31.3",
		"@tiptap/extension-subscript": "^3.31.3",
		"@tiptap/extension-superscript": "^3.31.3",
		"@tiptap/extension-table": "^3.31.3",
		"@tiptap/extension-text-align": "^3.31.3",
		"@tiptap/extension-text-style": "^3.31.3",
		"@tiptap/extension-underline": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@tiptap/starter-kit": "^3.31.3",
		"dayjs": "^1.11.23",
		"svelte-sonner": "^1.2.1",
		"yjs": "^13.6.32"
	},
	"publishConfig": {
		"access": "public"
	}
}
